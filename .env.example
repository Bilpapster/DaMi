# Copy this file to .env and fill in the values.   cp .env.example .env
# Never commit .env: it contains your personal URLs and keys.

# --- The brain --------------------------------------------------------------
# The tunnel URL of your Kaggle notebook. `dami kaggle start` writes it here for you (it can change on every start).
OLLAMA_HOST=https://your-dev-domain.ngrok-free.app
OLLAMA_MODEL=qwen3.5:9b

# Model settings
DAMI_TEMPERATURE=0.7
DAMI_THINK=true
DAMI_CONTEXT_LENGTH=16384

# Memory limit of the tool server in GB (protects your laptop; 0 = no limit; Linux only)
DAMI_TOOL_MEMORY_GB=4

# --- Kaggle (for `dami kaggle start`) ------------------------------------------
# The notebook you created once on kaggle.com: <kaggle-username>/<notebook-slug>
KAGGLE_NOTEBOOK=your-kaggle-username/llm-dami
# Your Kaggle API token (kaggle.com -> Settings -> API -> Generate New Token)
KAGGLE_API_TOKEN=
# Your ngrok authtoken (https://dashboard.ngrok.com/get-started/your-authtoken).
# `dami kaggle start` writes it into your PRIVATE Kaggle notebook. Never make that notebook public.
NGROK_AUTHTOKEN=

# --- Step 5: the second brain (your partner's notebook) -----------------------
# Your partner's notebook id (they share it with you on kaggle.com). `dami kaggle partner` then
# writes OLLAMA_HOST_B for you. Without OLLAMA_HOST_B, one brain plays both roles.
PARTNER_NOTEBOOK=
OLLAMA_HOST_B=
